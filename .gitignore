# --- Personal editor / IDE settings (each teammate keeps their own) ---
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- Secrets / local env ---
.env
.env.*
!.env.example

# --- Claude Code: personal, machine-specific files ---
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md

# --- Logs / temp ---
*.log
tmp/
.cache/

# --- Common build output & dependencies ---
node_modules/
dist/
build/
out/
coverage/
__pycache__/
*.pyc
.venv/
venv/

# --- Export working directory (.<split>.export-XXXXXXXX inside or beside the split): left behind only when a
#     rollback fails (its old/ then holds the previous files) or the process is killed ---
.*.export-*/

# --- Example output of the README's `auditenv.run ... --out trajectories.jsonl` (committed logs: trajectories/) ---
/trajectories.jsonl

# --- Night-run watchdog logs (local only) ---
.night-logs/

# --- Python packaging output ---
*.egg-info/
