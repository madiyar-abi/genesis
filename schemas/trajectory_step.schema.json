{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recorded audit trajectory step",
  "type": "object",
  "properties": {
    "episode_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "step": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "action": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "action.schema.json"
        }
      ]
    },
    "observation": {
      "$ref": "observation.schema.json"
    },
    "reward": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "terminated": {
      "type": "boolean"
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "episode_id",
    "step",
    "action",
    "observation",
    "reward",
    "terminated",
    "truncated"
  ],
  "additionalProperties": false,
  "if": {
    "properties": {
      "step": {
        "const": 0
      }
    }
  },
  "then": {
    "properties": {
      "action": {
        "type": "null"
      },
      "observation": {
        "$ref": "observation.schema.json#/$defs/initial"
      }
    }
  },
  "else": {
    "properties": {
      "action": {
        "$ref": "action.schema.json"
      },
      "observation": {
        "$ref": "observation.schema.json#/$defs/step"
      }
    }
  }
}
